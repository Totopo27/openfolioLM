# OpenFolioLM Environment Configuration Example

# Active LLM provider: "gemini" or "ollama"
LLM_PROVIDER=ollama

# Google Gemini API (leave empty if using Ollama only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Ollama local instance
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:3b

# Multimodal Vision (VLM) for diagram and figure transcription
ENABLE_VISION_TRANSCRIPTION=true
VISION_PROVIDER=ollama
VISION_MODEL=minicpm-v4.6

# Semantic Scholar (S2) API
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here
